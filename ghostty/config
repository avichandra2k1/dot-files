auto-update = off
auto-update-channel = stable

command = /bin/zsh

#window-decoration = none

font-family = TX-02

font-size = 14
font-thicken = true
font-thicken-strength = 255
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-feature = zero
cursor-text = #000000
font-feature = cv07
font-feature = cv11
font-feature = cv16

adjust-cell-height = 5%

keybind = cmd++=increase_font_size:3
keybind = cmd+-=decrease_font_size:1

keybind = cmd+h=goto_split:left
keybind = cmd+l=goto_split:right
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up

keybind = cmd+/=new_split:right
keybind = cmd+shift+/=new_split:down

#keybind = global:cmd+backquote=toggle_quick_terminal
#quick-terminal-position = bottom


window-inherit-font-size = true
window-inherit-working-directory = true
window-save-state = always

shell-integration = zsh
shell-integration-features = no-cursor,no-sudo,no-title
cursor-style = block
cursor-style-blink = false
#macos-titlebar-style = tabs
macos-titlebar-style = hidden
title = " "
background-opacity = 1.00
#background-opacity = 0.9
#background-blur-radius = 10

window-padding-x = 11
window-padding-y = 11

mouse-hide-while-typing = true

unfocused-split-opacity = 1

macos-icon = official
#macos-icon = microchip
#macos-icon = xray
#macos-icon = retro


#macos-icon = custom-style
#macos-icon-ghost-color = BCBEC4
#macos-icon-screen-color = 1E1F22
#
#CUSTOM
window-colorspace = "display-p3"
keybind = shift+enter=text:\x1b\r




